# Serving the app only. This is the default and what a host like Railway runs:
# it hands over the bundle and stores nothing.
NABZ_MODE=serve
PORT=8080

# Reception station on a clinic LAN. Adds ONE endpoint carrying patients and
# queue rows -- never prescriptions, examinations or growth records.
#   NABZ_MODE=clinic
#   NABZ_DATA=./.clinic-data
#
# Clinic mode refuses to start on a public host, because the clinic layer holds
# patient identity and PRODUCT.md rule 3.1 keeps that off servers we operate.
# Override only if you have decided otherwise and told your patients:
#   NABZ_ALLOW_PUBLIC=yes
