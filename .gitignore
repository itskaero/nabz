node_modules/
dist/
dev-dist/
*.local
.DS_Store
.vite/
artifacts/

# Playwright MCP writes screenshots and traces into the cwd
*.png
!public/*.png
# the project site's own images, which are content rather than scratch output
!docs/assets/*.png
traces/

# Playwright MCP session output
.playwright-mcp/

# clinic-mode data (a clinic runs this on its own machine)
.clinic-data/
.clinic-probe/
.env

# incremental typecheck cache: a local build artifact, not a source file
tsconfig.tsbuildinfo

# Fetched assets, NOT committed on purpose.
#
# The growth tables come from WHO's and CDC's published LMS files and the fonts
# are OFL binaries from Google Fonts. Both are pulled by `npm run assets` so
# every value in the app is traceable to its publisher rather than to a copy
# someone pasted into a repo years ago. Committing them would quietly break that.
public/fonts/*.ttf
public/fonts/MANIFEST.json
public/fonts/OFL.txt
src/data/growth/tables/

# scratch
.probe/

# packaged clinic station
release/
.exe-build/

# Working specs and local tooling -- kept out of the published repo.
# These stay on disk; they are simply not part of what ships.
CLAUDE.md
PRODUCT.md
DESIGN.md
.mcp.json
.claude/
.impeccable/live/
