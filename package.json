{
  "name": "nabz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bilingual clinical prescription PWA \u2014 on-device only, EN + ur-PK patient instructions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "assets:growth": "node scripts/fetch-growth-tables.mjs",
    "assets:fonts": "node scripts/fetch-fonts.mjs",
    "assets": "npm run assets:growth && npm run assets:fonts",
    "artifact:pdf": "node scripts/artifact.mjs pdf",
    "artifact:visual": "node scripts/artifact.mjs visual",
    "build:deploy": "npm run assets && npm run build",
    "start": "node server/index.mjs",
    "start:clinic": "node scripts/clinic.mjs",
    "build:exe": "npm run build && node scripts/build-exe.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bidi-js": "^1.0.3",
    "fontkit": "^2.0.4",
    "harfbuzzjs": "^1.6.0",
    "idb": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "~5.9.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
